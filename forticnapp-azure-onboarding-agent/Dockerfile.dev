# Dev/test image: same app, plus az CLI + lacework CLI for local end-to-end testing
# without installing either on the host. Not used for real deployment (see Dockerfile).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg jq \
    && curl -sL https://aka.ms/InstallAzureCLIDeb | bash \
    && curl -sSL https://raw.githubusercontent.com/lacework/go-sdk/main/cli/install.sh | bash \
    && apt-get purge -y gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

RUN useradd -m -u 10001 agent && chown -R agent /app
USER agent
ENV HOME=/home/agent
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
