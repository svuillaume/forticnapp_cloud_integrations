# ---- Bifrost LLM gateway (same variables as Claude Code) -------------------
LLM_API=anthropic                                   # anthropic | openai
ANTHROPIC_BASE_URL=https://bifrost.fabriclab.ca/anthropic
ANTHROPIC_AUTH_TOKEN=sk-bf-REPLACE_ME               # Bifrost virtual key
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.8-27b-anthropic  # default model in the picker
# BIFROST_MODEL_FILTER=qwen|claude                  # optional regex for the picker
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ---- FortiCNAPP (Lacework) API v2 -- same keys as ~/.lacework.toml -----------
# "demo" expands to demo.lacework.net. LW_ACCOUNT / LW_API_KEY / LW_API_SECRET also work.
# If these are absent, ~/.lacework.toml [default] (or LW_PROFILE) is used.
account = "demo"
api_key = "FORTINET_XXXXXXX"
api_secret = "REPLACE_ME"
version = 2
# subaccount = "" 

# ---- Azure client secrets, referenced by the agent as secret_ref=env:<NAME> ---
# Only variables with this prefix can be referenced.
SECRET_ENV_PREFIX=FCNAPP_SECRET_
FCNAPP_SECRET_AZURE=REPLACE_ME

# ---- Behaviour ---------------------------------------------------------------
ALLOW_CREATE=true          # false = read-only everywhere
MAX_AGENT_STEPS=8
ENABLE_AZURE_TOOLS=true   # agent runs az / preflight itself (needs `az login` on this host)
# AZ_BIN=az
# MCP_SERVERS={"forticnapp":{"url":"http://mcp-host:8765/mcp"}}   # default: bundled stdio server
